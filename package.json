{
	"name": "vite-plugin-atlas",
	"version": "0.1.0",
	"description": "A convention-driven component documentation plugin for Vite + React",
	"type": "module",
	"main": "./dist/plugin/index.js",
	"module": "./dist/plugin/index.js",
	"types": "./dist/plugin/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/plugin/index.d.ts",
			"import": "./dist/plugin/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/types/index.js"
		}
	},
	"bin": {
		"atlas": "./dist/cli/index.js"
	},
	"files": [
		"dist",
		"src/ui",
		"ATLAS_SKILL.md"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"vite",
		"vite-plugin",
		"react",
		"documentation",
		"components",
		"atlas"
	],
	"license": "MIT",
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18",
		"vite": ">=5"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"dependencies": {
		"shiki": "^3.4.2",
		"tinyglobby": "^0.2.12"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"@types/node": "^25.3.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tsup": "^8.4.0",
		"typescript": "^5.8.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	}
}
