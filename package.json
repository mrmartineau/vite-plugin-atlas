{
  "name": "vite-plugin-atlas",
  "version": "0.3.0",
  "description": "A convention-driven component documentation plugin for Vite + React",
  "keywords": [
    "atlas",
    "components",
    "documentation",
    "react",
    "vite",
    "vite-plugin"
  ],
  "license": "MIT",
  "bin": {
    "atlas": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "src/ui",
    "ATLAS_SKILL.md"
  ],
  "type": "module",
  "main": "./dist/plugin/index.js",
  "module": "./dist/plugin/index.js",
  "types": "./dist/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./components": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "release-it"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "radix-ui": "^1.4.3",
    "shiki": "^3.23.0",
    "tinyglobby": "^0.2.15"
  },
  "devDependencies": {
    "@mrmartineau/kit": "^1.1.0",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "release-it": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
